APP_ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# produção: postgresql://usuario:senha@host:5432/historico (a URL do Neon pode ser colada como vem)
# DB_SERVERLESS=true  # automático na Vercel: sem pool de conexões

SECRET_KEY=troque-isto-por-um-segredo-longo-e-aleatorio
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# origens permitidas (separadas por vírgula) — front Jinja2 / React
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
DOCS_ENABLED=true

# local | s3 | db (db = arquivos gravados no próprio banco, sem S3)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Vercel: no máximo 4 (o limite da plataforma é 4,5 MB por requisição)
MAX_UPLOAD_MB=20
