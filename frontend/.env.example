# URL onde a API (backend) está rodando
API_BASE_URL=http://127.0.0.1:8000
API_PREFIX=/api/v1

# Segredo que assina o cookie de sessão do front (troque em produção)
SECRET_KEY=troque-isto-por-um-segredo-longo-e-aleatorio
# true em produção (HTTPS): o cookie só trafega por conexão segura
COOKIE_SECURE=false
SESSION_MAX_AGE_DAYS=7

TIMEZONE=America/Sao_Paulo
